# 本地开发配置：复制本文件为 application-dev.yml 并填实际值
# （application-dev.yml 已在 .gitignore，不会入库）
app:
  name: NL2SQL AI问数——DEV
redis:
  host: "127.0.0.1"
  port: 6379
  db: 0
  password:
postgres:
  host: "127.0.0.1"
  port: 5432
  database: nl2sql
  username: postgres
  password: <your_postgres_password>
# 飞书机器人通道（可选，旁路接入）：飞书开放平台「企业自建应用 → 机器人」拿 app_id/app_secret。
# 事件订阅选「长连接」；订阅 im.message.receive_v1 + card.action.trigger；权限开 im:message:send_as_bot。
feishu:
  enable: false
  app_id: cli_xxxxxxxxxxxxxxxx
  app_secret: <your_app_secret>
  whitelist: []              # open_id（ou_xxx）列表，空=不限；公网暴露前务必收紧
  card_throttle_ms: 300      # 卡片流式全量重写节流间隔（ms）
# 全站登录（单账户，hmac 签名 cookie 认证）；复制到 application-dev.yml 填实际密码
auth:
  username: admin
  password: <your_password>

